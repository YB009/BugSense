PORT=3000
TCP_HOST=127.0.0.1
TCP_PORT=4000
INGESTION_TCP_HOST=127.0.0.1
INGESTION_TCP_PORT=4001
ALERT_SERVICE_URL=http://127.0.0.1:3003
# Optional override for the alert-service HTTP listener. Use this when
# ALERT_SERVICE_URL is a host-only private-network URL such as Railway's
# *.railway.internal and the HTTP service port is configured separately.
ALERT_SERVICE_HTTP_PORT=
DATABASE_URL=postgres://bugsense:bugsense@127.0.0.1:5432/bugsense
DATABASE_SSL=false
BUGSENSE_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token
GOOGLE_AI_API_KEY=...
GOOGLE_AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=...
BUGSENSE_AI_PANEL_MODEL=gemini-2.5-flash
